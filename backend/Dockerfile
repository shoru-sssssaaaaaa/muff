# --- Build stage ---
FROM gradle:8.12-jdk21 AS build
WORKDIR /app
COPY build.gradle.kts settings.gradle.kts gradle.properties ./
COPY gradle ./gradle
RUN gradle dependencies --no-daemon || true
COPY src ./src
RUN gradle shadowJar --no-daemon

# --- Run stage ---
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/build/libs/*-all.jar app.jar

ARG PORT
ARG DATABASE_URL
ARG DATABASE_USER
ARG DATABASE_PASSWORD
ARG DATABASE_MAX_POOL_SIZE
ARG CORS_ALLOWED_HOSTS
ARG RSS_POLLING_INTERVAL_MINUTES
ARG POPULARITY_AGGREGATION_INTERVAL_MINUTES

ENV PORT=${PORT}
ENV DATABASE_URL=${DATABASE_URL}
ENV DATABASE_USER=${DATABASE_USER}
ENV DATABASE_PASSWORD=${DATABASE_PASSWORD}
ENV DATABASE_MAX_POOL_SIZE=${DATABASE_MAX_POOL_SIZE}
ENV CORS_ALLOWED_HOSTS=${CORS_ALLOWED_HOSTS}
ENV RSS_POLLING_INTERVAL_MINUTES=${RSS_POLLING_INTERVAL_MINUTES}
ENV POPULARITY_AGGREGATION_INTERVAL_MINUTES=${POPULARITY_AGGREGATION_INTERVAL_MINUTES}

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]

{
  "info": {
    "name": "MUFF Backend API Tests",
    "description": "Newman test collection for MUFF Backend MVP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Catalog",
      "item": [
        {
          "name": "GET /v1/catalog/sources — returns 200 with array",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/catalog/sources",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "catalog", "sources"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Content-Type is application/json', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('Each source has required fields', function () {",
                  "    const json = pm.response.json();",
                  "    json.forEach(function (source) {",
                  "        pm.expect(source).to.have.property('source_id');",
                  "        pm.expect(source).to.have.property('name');",
                  "        pm.expect(source).to.have.property('rss_url');",
                  "        pm.expect(source).to.have.property('site_url');",
                  "        pm.expect(source).to.have.property('default_category');",
                  "        pm.expect(source).to.have.property('status');",
                  "        pm.expect(source.status).to.equal('active');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Feed — New",
      "item": [
        {
          "name": "GET /v1/feed/new — returns 200 with FeedResponse",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/feed/new",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "feed", "new"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has items array', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('items');",
                  "    pm.expect(json.items).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Response has next_cursor field', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('next_cursor');",
                  "});",
                  "",
                  "pm.test('Articles have required fields', function () {",
                  "    const json = pm.response.json();",
                  "    json.items.forEach(function (article) {",
                  "        pm.expect(article).to.have.property('article_id');",
                  "        pm.expect(article).to.have.property('source_id');",
                  "        pm.expect(article).to.have.property('source_name');",
                  "        pm.expect(article).to.have.property('title');",
                  "        pm.expect(article).to.have.property('url');",
                  "        pm.expect(article).to.have.property('published_at');",
                  "        pm.expect(article).to.have.property('category');",
                  "    });",
                  "});",
                  "",
                  "// Save cursor for pagination test",
                  "const json = pm.response.json();",
                  "if (json.next_cursor) {",
                  "    pm.collectionVariables.set('newFeedCursor', json.next_cursor);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/feed/new?limit=5 — respects limit",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/feed/new?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "feed", "new"],
              "query": [
                { "key": "limit", "value": "5" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Items count is at most 5', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.items.length).to.be.at.most(5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /v1/feed/new?cursor=invalid — returns 400",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/feed/new?cursor=invalid!!!",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "feed", "new"],
              "query": [
                { "key": "cursor", "value": "invalid!!!" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error response has correct structure', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('error', 'bad_request');",
                  "    pm.expect(json).to.have.property('message');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },

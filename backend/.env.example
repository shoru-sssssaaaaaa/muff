# Server port (default: 8080)
PORT=8080

# PostgreSQL connection
# docker-compose: db:5432 / local: localhost:5432 (application.conf default)
DATABASE_URL=jdbc:postgresql://db:5432/muff
DATABASE_USER=muff
DATABASE_PASSWORD=muff
DATABASE_MAX_POOL_SIZE=10

# CORS allowed hosts (comma-separated, host:port)
# Example for production: "admin.muff.app,www.muff.app"
CORS_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000

# Scheduled job intervals (minutes)
RSS_POLLING_INTERVAL_MINUTES=10
POPULARITY_AGGREGATION_INTERVAL_MINUTES=30
